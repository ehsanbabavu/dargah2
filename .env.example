# ==============================================================================
# فایل نمونه تنظیمات محیطی (Environment Variables Example) - سامانه رخشان
# نکته: این فایل حاوی مقادیر نمونه است. در محیط اصلی (Production) مقادیر واقعی را قرار دهید.
# ==============================================================================

# تنظیمات سرور
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://yourdomain.com

# پایگاه داده PostgreSQL
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/rakhsh_db

# کلیدهای امنیتی و امضای توکن (ضروری در محیط Production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
SESSION_SECRET=your_super_secret_session_key_at_least_32_characters

# اطلاعات حساب مدیریت اصلی (Admin Credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_123
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=09123456789

# سرویس سامانه پیامک
SMS_API_TOKEN=your_sms_provider_api_token
SMS_PROVIDER=ippanel

# سرویس ربات تلگرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_SECRET_TOKEN=your_random_telegram_webhook_secret_token

# تنظیمات Puppeteer / اسکرین‌شات
PUPPETEER_EXECUTABLE_PATH=
