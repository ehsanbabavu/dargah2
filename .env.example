# ------------------------------------------------------------------------------
# نمونه فایل تنظیمات محیطی (Environment Variables) برای انتقال به سرور واقعی
# این فایل را به نام .env در ریشه پروژه ذخیره کرده و مقادیر واقعی را وارد کنید.
# ------------------------------------------------------------------------------

# پورت اجرای برنامه (پیش‌فرض: 3000)
PORT=3000

# حالت اجرای برنامه (برای سرور واقعی حتماً روی production تنظیم شود)
NODE_ENV=production

# آدرس اتصال به دیتابیس PostgreSQL واقعی
# فرمت: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@localhost:5432/rakhsh_db

# کلیدهای امنیتی برای نشست‌ها (Sessions) و توکن‌ها (JWT)
# یک رشته متنی طولانی و تصادفی برای امنیت بیشتر وارد کنید
SESSION_SECRET=your_very_secure_session_secret_change_me_98741
JWT_SECRET=your_very_secure_jwt_secret_change_me_12345

# رمز عبور ادمین ارشد (نام کاربری پیش‌فرض: ehsan)
# این پسورد در اولین لود برنامه یا اجرای اول دیتابیس ست می‌شود
ADMIN_PASSWORD=admin123

# تنظیمات وب‌سرویس پیامکی (در صورت استفاده از پیامک)
SMS_API_TOKEN=your_sms_token_here

# تنظیمات ربات تلگرام (در صورت فعال‌سازی نوتیفیکیشن‌های تلگرام)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
